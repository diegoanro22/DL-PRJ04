# Entorno
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/
.env

# Datos (se descargan con scripts/ o se montan en Kaggle)
data/*
!data/README.md
!data/consentimiento_plantilla.md

# Artefactos de entrenamiento (los pesos van a Hugging Face Hub)
runs/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Audio suelto (las grabaciones propias no se versionan)
*.wav
*.flac
*.webm

# Panel: el build lo genera Vite (pnpm build) o el Dockerfile
app/static/*
app/web/node_modules/
# Modelos empaquetados para la API (ONNX de ~1.3 GB): se generan con app.package_model
app/models/

# Impeccable: capturas y estado de builds locales
.impeccable/review/
.impeccable/build/
.impeccable/questions/
